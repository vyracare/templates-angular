    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-server": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/ssr": "22.2.6",
    "@vyracare/design-system": "^2.0.0",
    "bootstrap-icons": "^1.11.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^22.0.0",
    "@angular-devkit/build-angular": "22.2.6",
